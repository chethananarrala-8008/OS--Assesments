#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <time.h>

int main()
{
    clock_t start, end;
    start = clock();

    for (int i = 0; i < 1000; i++)
    {
        pid_t pid = fork();

        if (pid == 0)
        {
            _exit(0);
        }
        else if (pid > 0)
        {
            wait(NULL);
        }
        else
        {
            perror("fork failed");
            return 1;
        }
    }

    end = clock();

    printf("Created 1000 processes\n");
    printf("CPU time: %.6f seconds\n",
           (double)(end - start) / CLOCKS_PER_SEC);

